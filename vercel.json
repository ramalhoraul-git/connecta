{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "admin/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/admin/login.html",
      "dest": "/admin/login.html"
    },
    {
      "src": "/admin/dashboard.html",
      "dest": "/admin/dashboard.html"
    },
    {
      "src": "/blog.html",
      "dest": "/blog.html"
    },
    {
      "src": "/artigo.html",
      "dest": "/artigo.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
